{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "img/**/*", "use": "@vercel/static" },
    { "src": "logos/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "src": "/logos/(.*)", "dest": "/logos/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
